    "text": "<!doctype html><html><body><button id=\"store-filter\">Store</button><button id=\"channel-filter\">Channel</button><div id=\"kpi-revenue\">$42K SYNTHETIC</div><svg id=\"chart-sales\"></svg><div id=\"insights\">ready</div><script>document.querySelector('#store-filter').onclick=()=>document.querySelector('#insights').textContent='filtered';</script></body></html>"
